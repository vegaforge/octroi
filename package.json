{
  "name": "octroi",
  "version": "0.0.1",
  "private": true,
  "description": "Open-source pay-per-crawl infrastructure for the web, on Stellar",
  "license": "Apache-2.0",
  "author": "Emmanuel Omemgboji",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install --reset-hooks-path",
    "web:dev": "pnpm --filter @octroi/web-dashboard dev",
    "web:build": "pnpm --filter @octroi/web-dashboard build",
    "web:start": "pnpm --filter @octroi/web-dashboard start",
    "migrate": "pnpm --filter @octroi/persistence migrate",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker-compose.yml down -v",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "preflight": "./scripts/preflight.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@types/node": "^20.11.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
