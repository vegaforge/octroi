# =============================================================================
# CrawlPay environment template
#
# Copy to .env and fill the empty fields. Never commit .env.
# =============================================================================

# ─── Runtime ────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─── Network ────────────────────────────────────────────────
# stellar-testnet | stellar-mainnet
CRAWLPAY_NETWORK=stellar-testnet

# ─── Stellar / Soroban ──────────────────────────────────────
# Public Soroban RPC endpoint. Testnet default below; use a production
# provider for mainnet.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# USDC asset as CODE:ISSUER_G_ADDRESS.
#   Mainnet (Circle): USDC:GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
#   Testnet: use the testnet USDC issuer (see developers.stellar.org / stellar.expert).
CRAWLPAY_USDC_ASSET=

# USDC Stellar Asset Contract (SAC) address: the contract the `transfer`
# invocation targets. Derive it for your network and asset, e.g.:
#   stellar contract id asset --asset USDC:<ISSUER> --network testnet
CRAWLPAY_USDC_SAC=

# ─── Facilitator ────────────────────────────────────────────
FACILITATOR_PORT=3001

# Stellar secret seed (S...) used ONLY to sign receipts. It holds no funds, so
# generate a fresh keypair and never fund it. Receipts are signed with this
# key, and its public G-address is published at /pubkey.
CRAWLPAY_RECEIPT_SEED=

# Stellar secret seed (S...) of the account that sponsors transaction fees so
# crawlers never need XLM. Must hold a small XLM balance.
CRAWLPAY_FEE_SPONSOR_SEED=

# ─── Crawler SDK ────────────────────────────────────────────
# Stellar secret seed (S...) the crawler signs payments with. Its account
# must hold USDC to spend.
CRAWLPAY_CRAWLER_SECRET=

# ─── API gateway + persistence ──────────────────────────────
API_PORT=8080
DATABASE_URL=
REDIS_URL=

# ─── Web dashboard ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_FACILITATOR_URL=http://localhost:3001
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_EXPLORER_URL=https://stellar.expert/explorer/testnet
