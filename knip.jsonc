// Knip finds dependencies that nothing imports, imports of packages that are
// not declared, and unresolved imports. CI runs it through `pnpm knip`, so a
// pull request cannot add a package the code does not use.
{
  "workspaces": {
    "apps/facilitator": {
      // The logger loads pino-pretty by name as a pino transport target
      // (src/logger.ts), which Knip cannot follow.
      "ignoreDependencies": ["pino-pretty"],
    },
  },
}
